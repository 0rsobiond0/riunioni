# Copia in .env e compila quando hai un endpoint LLM raggiungibile.
# Senza queste variabili i sottotitoli funzionano lo stesso.

RIUNIONI_LLM_BASE_URL=http://192.168.1.4:8080/v1
RIUNIONI_LLM_API_KEY=chiave-qui
RIUNIONI_LLM_MODELS=modello-1,modello-2

