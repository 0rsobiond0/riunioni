# Copy to .env and fill in when you have a reachable LLM endpoint.
# Without these variables, subtitles still work.

RIUNIONI_LLM_BASE_URL=http://localhost:8080/v1
RIUNIONI_LLM_API_KEY=your-api-key
RIUNIONI_LLM_MODELS=model-1,model-2

# USB microphone device (see: .venv/bin/python list_mics.py)
# RIUNIONI_AUDIO_DEVICE=hw:2,0
